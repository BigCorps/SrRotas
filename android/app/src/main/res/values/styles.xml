<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#073746</item>
        <item name="android:navigationBarColor">#073746</item>
        <item name="android:colorAccent">#0D7F85</item>
        <item name="android:windowBackground">#F7F0C8</item>
        <item name="android:alertDialogTheme">@style/SrRotasDialogTheme</item>
    </style>

    <!-- Padroniza AlertDialog legado sem introduzir nova dependência Material. -->
    <style name="SrRotasDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/sr361_dialog_background</item>
        <item name="android:colorAccent">#0D7F85</item>
        <item name="android:textColorPrimary">#073746</item>
        <item name="android:textColorSecondary">#58747C</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
