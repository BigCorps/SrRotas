<?xml version="1.0" encoding="utf-8"?>
<!-- R3-Lab: atalho de lançador SOMENTE no APK experimental (buildType r3lab). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity-alias
            android:name="com.srrotas.app.r3lab.R3LabLauncher"
            android:exported="true"
            android:label="@string/r3lab_launcher_label"
            android:targetActivity="com.srrotas.app.r3lab.R3LabActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
