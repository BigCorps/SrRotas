  "reader_changes": [
    "Evaluate isolated Uber and 99 offers from the same OCR frame before returning, enabling full-screen split-screen dual monitoring.",
    "Add 99-only flexible time/distance reconstruction inside an already isolated 99 card cluster.",
    "Keep classic 99 strict parser as first path and retain its parser version.",
    "Require 99-specific anchors under navigation noise to avoid cross-app numeric mixing."
  ],
  "diagnostic_changes": [
    "Add provisional bug button/menu to floating HUD.",
    "Add privacy-safe MANUAL_FAILURE trace marker independent of MediaProjection service lifetime.",
    "Share standard diagnostic as sr-rotas-diagnostic.json via read-only cache ContentProvider.",
    "Add journey notification failure action and capture-interrupted contingency notification.",
    "Recovery activity reauthorizes MediaProjection while preserving current journey."
  ],
